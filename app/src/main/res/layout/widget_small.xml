<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp">

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-8dp"
        android:layout_marginBottom="2dp"
        android:alpha="0.5"
        android:src="@drawable/widget_ripple" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="光阴长河"
            android:textColor="@color/ink3"
            android:textSize="10sp"
            android:letterSpacing="0.18"
            android:fontFamily="serif" />

        <View
            android:layout_width="22dp"
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@color/jade" />

        <TextView
            android:id="@+id/w_lived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已在此间 —"
            android:textColor="@color/jade"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/w_ahead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="前方尚有 —"
            android:textColor="@color/ink2"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:fontFamily="serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="8dp"
            android:background="@color/widget_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/w_mark_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="最近 · —"
                android:textColor="@color/ink2"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/w_mark_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/jade"
                android:textSize="14sp"
                android:fontFamily="serif" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
