<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <TextView
        android:id="@+id/w_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="光阴长河"
        android:textColor="@color/ink3"
        android:textSize="11sp"
        android:fontFamily="serif" />

    <View
        android:layout_width="26dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="9dp"
        android:background="@color/jade" />

    <TextView
        android:id="@+id/w_lived"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="已在此间 —"
        android:textColor="@color/jade"
        android:textSize="16sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/w_ahead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="前方尚有 —"
        android:textColor="@color/ink2"
        android:textSize="16sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:lineSpacingExtra="3dp"
        android:fontFamily="serif" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="9dp"
        android:background="@color/widget_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_mark_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="最近 · —"
            android:textColor="@color/ink2"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/w_mark_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/jade"
            android:textSize="17sp"
            android:fontFamily="serif" />
    </LinearLayout>

</LinearLayout>
